# Environment read by signon. Copy the parts a service needs into its own
# .env / systemd unit — never commit real values.

# --- site identity -----------------------------------------------------------
# Public origin of the site the user is looking at. Verification and reset
# links are built against this.
APP_BASE_URL=https://dash

# Public prefix that reaches THIS backend, when it is not <APP_BASE_URL>/api.
# The Worker strips /api before forwarding, so the backend never sees it.
# Only OAuth redirect URIs depend on this.
#PUBLIC_BASE_URL=https://dash/api

# Origins allowed to make state-changing requests. Defaults to APP_BASE_URL
# alone; set this when running the frontend on a dev server.
#ALLOWED_ORIGINS=http://localhost:3001

# Drops `Secure` from the session cookie. Local plain-HTTP development only —
# on a real deployment this makes the session a network-readable credential.
#INSECURE_COOKIES=1

# The visitor's address, as the site's Worker forwards it. A Worker that
# forwards to a hostname on another zone makes Cloudflare report the Worker's
# own address as CF-Connecting-IP — every visitor the same, so per-address
# rate limits become one bucket and every recorded address is the Worker's.
# With this set (16+ characters), the Worker's X-Client-IP is used instead,
# but only when it arrives with X-Client-IP-Key equal to this value; otherwise
# both headers are stripped. The same value goes in the Worker as a secret
# (`npx wrangler secret put CLIENT_IP_KEY`). Generate: openssl rand -hex 32
#CLIENT_IP_KEY=

# Feature `welcome-remote`: where the welcome's current text is read when one
# goes out (JSON {subject, body, action_label, action_url}); empty turns it
# off. When set it alone decides: a 404, an error or no answer sends no welcome
# (the built-in Config::welcome is used only while this is unset or empty).
# dash and register default to the landing Worker's /email-templates/<site>.welcome.
#WELCOME_TEMPLATE_URL=
# The follow-up's text, same shape; there is no built-in follow-up.
#FOLLOWUP_TEMPLATE_URL=

# The key a site's template admin presents to start a catch-up welcome or
# follow-up run (mail_admin_router, nested for example at /internal/mail).
# At least 16 characters; unset, those routes are 404. One value, set on
# every side that calls or serves those routes.
#MAIL_ADMIN_KEY=

# --- mail --------------------------------------------------------------------
# An SMTP relay (Brevo here). All five
# required, not optional: AccountState::from_env refuses to start the service
# if any is missing (Mailer::from_env). The log-only, no-relay-needed behavior
# for a smoke test is Mailer::disabled() / AccountState::from_env_with_mailer,
# a deliberate opt-out a test reaches for in code — not what an unset env var
# here falls back to. EMAIL_FROM must be a verified sender on the relay
# account, not defaulted to EMAIL_LOGIN — that is a relay-internal login
# handle, not a domain address with SPF/DKIM behind it, and the relay can
# accept the send (`250 OK`) and silently drop it downstream for exactly that
# reason, with nothing on this end to show for it.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_LOGIN=
EMAIL_KEY=
EMAIL_FROM=no-reply@example.com

# Explicit, loud opt-out: mail goes to the log
# instead of a relay. Local runs and smoke tests only — it is a flag, not a
# fallback, so a misconfigured deployment fails instead of going quiet.
#EMAIL_DISABLED=1

# --- language ----------------------------------------------------------------
# The site's own language: what a request naming none of en, ru, fr, de, zh, ja is
# answered in, and the language of mail no request causes. English when unset.
#APP_LANG=en

# --- mailing list ------------------------------------------------------------
# Where "someone subscribed to updates and news" alerts go, comma separated.
# Unset means nobody is told; signups are recorded either way.
#NOTIFY_TO=owner@example.com

# --- notifications (feature `notify`) -----------------------------------------
# Channels of Notifier::from_env; any left unset is no channel. Each value is a
# secret but the chat ids and the mail addresses.
#NOTIFY_SLACK_WEBHOOK=https://hooks.slack.com/services/...
#NOTIFY_TEAMS_WEBHOOK=https://....logic.azure.com/workflows/...
#NOTIFY_TELEGRAM_TOKEN=
#NOTIFY_TELEGRAM_CHAT=-1001234567890
#NOTIFY_WEBHOOK_URL=https://alerts.example.com/in
#NOTIFY_WEBHOOK_BEARER=
#NOTIFY_EMAIL_TO=ops@example.com

# --- SSO ---------------------------------------------------------------------
# A provider with no credentials is simply absent from GET /account/oauth, and
# the frontend renders no button for it. Register the redirect URI as
# <PUBLIC_BASE_URL>/account/oauth/<provider>/callback.
#
# GitHub:   https://github.com/settings/developers
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=
#
# LinkedIn: https://www.linkedin.com/developers/apps — the app needs the
# "Sign In with LinkedIn using OpenID Connect" product; the older
# r_liteprofile/r_emailaddress scopes are retired.
#OAUTH_LINKEDIN_CLIENT_ID=
#OAUTH_LINKEDIN_CLIENT_SECRET=
#
# Google:   https://console.cloud.google.com/apis/credentials
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
#
# Apple:    https://developer.apple.com/account/resources — a Services ID (the
# client id), a "Sign in with Apple" key (.p8) and your Team ID. No client
# secret: an ES256 JWT is minted per sign-in from the key. Apple posts the
# callback (form_post); outgoing mail to @privaterelay.appleid.com addresses
# needs your sending domain registered with Apple's Private Email Relay.
#OAUTH_APPLE_CLIENT_ID=
#OAUTH_APPLE_TEAM_ID=
#OAUTH_APPLE_KEY_ID=
#OAUTH_APPLE_PRIVATE_KEY_PATH=/etc/<service>/AuthKey_XXXXXXXXXX.p8
# or inline, with \n for newlines:
#OAUTH_APPLE_PRIVATE_KEY=
#
# Amazon:   https://developer.amazon.com/loginwithamazon/console — a security
# profile with this redirect URI under "Allowed Return URLs". Amazon does not
# vouch for the email, so first sign-in confirms it with a mailed code.
#OAUTH_AMAZON_CLIENT_ID=
#OAUTH_AMAZON_CLIENT_SECRET=
#
# Facebook: https://developers.facebook.com/apps — Facebook Login, a privacy
# policy URL and a data-deletion URL are required before Live mode. Like
# Amazon, the email is confirmed with a code on first sign-in.
#OAUTH_FACEBOOK_CLIENT_ID=
#OAUTH_FACEBOOK_CLIENT_SECRET=
#
# Microsoft: https://entra.microsoft.com → App registrations → New, supported
# account types "Accounts in any organizational directory and personal
# Microsoft accounts" (the `common` endpoint), this redirect URI as a "Web"
# platform URI, then Certificates & secrets → a client secret (they expire:
# 24 months at most). Microsoft does not vouch for the email either — a tenant
# admin can set any address — so it is confirmed with a code like Amazon's.
#OAUTH_MICROSOFT_CLIENT_ID=
#OAUTH_MICROSOFT_CLIENT_SECRET=
#
# Federated instead (feature `sso-broker`, for sites behind one SSO
# service): the SSO service owns every provider and customer connection,
# and the OAUTH_* lines above are ignored. BrokerClient::from_env reads:
#SSO_BROKER_URL=http://127.0.0.1:8096
# This site's key for the service's /internal/* — the key also tells the
# service which site a sign-in ticket may be redeemed by.
#SSO_BROKER_KEY=
