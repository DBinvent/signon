# Environment read by user_mgmt. Copy the parts a service needs into its own
# .env / systemd unit — never commit real values.

# --- site identity -----------------------------------------------------------
# Public origin of the site the user is looking at. Verification and reset
# links are built against this.
APP_BASE_URL=https://dash

# Public prefix that reaches THIS backend, when it is not <APP_BASE_URL>/api.
# The Worker strips /api before forwarding, so the backend never sees it.
# Only OAuth redirect URIs depend on this.
#PUBLIC_BASE_URL=https://dash/api

# Origins allowed to make state-changing requests. Defaults to APP_BASE_URL
# alone; set this when running the frontend on a dev server.
#ALLOWED_ORIGINS=http://localhost:3001

# Drops `Secure` from the session cookie. Local plain-HTTP development only —
# on a real deployment this makes the session a network-readable credential.
#INSECURE_COOKIES=1

# --- mail --------------------------------------------------------------------
# Brevo relay, same values as trust-atria-bo/crates/env.sample. All five
# required, not optional: AccountState::from_env refuses to start the service
# if any is missing (Mailer::from_env). The log-only, no-relay-needed behavior
# for a smoke test is Mailer::disabled() / AccountState::from_env_with_mailer,
# a deliberate opt-out a test reaches for in code — not what an unset env var
# here falls back to. EMAIL_FROM must be a verified sender on the relay
# account, not defaulted to EMAIL_LOGIN — that is a relay-internal login
# handle, not a domain address with SPF/DKIM behind it, and the relay can
# accept the send (`250 OK`) and silently drop it downstream for exactly that
# reason, with nothing on this end to show for it.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_LOGIN=
EMAIL_KEY=
EMAIL_FROM=no-reply@ta.com

# Explicit, loud opt-out used by the four services: mail goes to the log
# instead of a relay. Local runs and smoke tests only — it is a flag, not a
# fallback, so a misconfigured deployment fails instead of going quiet.
#EMAIL_DISABLED=1

# --- mailing list ------------------------------------------------------------
# Where "someone subscribed to updates and news" alerts go, comma separated.
# Unset means nobody is told; signups are recorded either way. Mirrors
# NOTIFY_TO in trust-atria-landing's Worker.
#NOTIFY_TO=owner@example.com

# --- SSO ---------------------------------------------------------------------
# A provider with no credentials is simply absent from GET /account/oauth, and
# the frontend renders no button for it. Register the redirect URI as
# <PUBLIC_BASE_URL>/account/oauth/<provider>/callback.
#
# GitHub:   https://github.com/settings/developers
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=
#
# LinkedIn: https://www.linkedin.com/developers/apps — the app needs the
# "Sign In with LinkedIn using OpenID Connect" product; the older
# r_liteprofile/r_emailaddress scopes are retired.
#OAUTH_LINKEDIN_CLIENT_ID=
#OAUTH_LINKEDIN_CLIENT_SECRET=
#
# Google:   https://console.cloud.google.com/apis/credentials
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
